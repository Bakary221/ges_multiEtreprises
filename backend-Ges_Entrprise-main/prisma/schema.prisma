generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  role          Role
  companyId     Int?
  status        Status         @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  employee      Employee?
  logs          Log[]
  notifications Notification[]
  company       Company?       @relation(fields: [companyId], references: [id])
  grantedLoans  Loan[]         @relation("LoanGrantedBy")
  approvedLoans Loan[]         @relation("LoanApprovedBy")

  @@index([companyId], map: "users_companyId_fkey")
  @@map("users")
}

model Company {
  id             Int           @id @default(autoincrement())
  name           String
  settings       Json?
  currency       String        @default("EUR")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  logo           String?
  primaryColor   String?
  secondaryColor String?
  departments    Department[]
  employees      Employee[]
  integrations   Integration[]
  logs           Log[]
  payruns        Payrun[]
  users          User[]

  @@map("companies")
}

model Employee {
  id               Int            @id @default(autoincrement())
  userId           Int?           @unique
  matricule        String?        @unique
  name             String
  email            String?
  position         String
  salary           Float
  contractType     ContractType?  @default(FIXE)
  departmentId     Int?
  contractId       Int?
  companyId        Int
  archived         Boolean        @default(false)
  badgeGeneratedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  attendances   Attendance[]
  contract      Contract?
  company       Company        @relation(fields: [companyId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  leaveRequests LeaveRequest[]
  payslips      Payslip[]
  timesheets    Timesheet[]
  loans         Loan[]

  @@index([companyId], map: "employees_companyId_fkey")
  @@index([departmentId], map: "employees_departmentId_fkey")
  @@map("employees")
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String
  companyId Int
  createdAt DateTime   @default(now())
  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@index([companyId], map: "departments_companyId_fkey")
  @@map("departments")
}

model Contract {
  id         Int       @id @default(autoincrement())
  type       String
  startDate  DateTime
  endDate    DateTime?
  salary     Float
  employeeId Int       @unique
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@map("contracts")
}

model Attendance {
  id          Int            @id @default(autoincrement())
  employeeId  Int
  timestamp   DateTime
  type        AttendanceType
  hoursWorked Float?
  createdAt   DateTime       @default(now())
  employee    Employee       @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "attendances_employeeId_fkey")
  @@map("attendances")
}

model Timesheet {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  month       String
  hoursWorked Float
  validated   Boolean  @default(false)
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "timesheets_employeeId_fkey")
  @@map("timesheets")
}

model Payrun {
  id          Int           @id @default(autoincrement())
  companyId   Int
  month       String
  totalAmount Float
  status      PayrunStatus  @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company       @relation(fields: [companyId], references: [id])
  payslips    Payslip[]

  @@index([companyId], map: "payruns_companyId_fkey")
  @@map("payruns")
}

model Payslip {
  id         Int       @id @default(autoincrement())
  employeeId Int
  payrunId   Int
  netSalary  Float
  pdfUrl     String?
  createdAt  DateTime  @default(now())
  payments   Payment[]
  employee   Employee  @relation(fields: [employeeId], references: [id])
  payrun     Payrun    @relation(fields: [payrunId], references: [id])

  @@index([employeeId], map: "payslips_employeeId_fkey")
  @@index([payrunId], map: "payslips_payrunId_fkey")
  @@map("payslips")
}

model Payment {
  id        Int           @id @default(autoincrement())
  payslipId Int
  status    PaymentStatus @default(PENDING)
  method    String
  date      DateTime?
  createdAt DateTime      @default(now())
  payslip   Payslip       @relation(fields: [payslipId], references: [id])

  @@index([payslipId], map: "payments_payslipId_fkey")
  @@map("payments")
}

model LeaveRequest {
  id         Int         @id @default(autoincrement())
  employeeId Int
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  employee   Employee    @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "leave_requests_employeeId_fkey")
  @@map("leave_requests")
}

model Notification {
  id        Int                @id @default(autoincrement())
  userId    Int
  type      String
  content   String
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id])

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model Integration {
  id        Int      @id @default(autoincrement())
  type      String
  config    Json
  companyId Int
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "integrations_companyId_fkey")
  @@map("integrations")
}

model Log {
  id        Int      @id @default(autoincrement())
  userId    Int
  companyId Int?
  action    String
  entity    String
  details   Json?
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([companyId], map: "logs_companyId_fkey")
  @@index([userId], map: "logs_userId_fkey")
  @@map("logs")
}

enum Role {
  SUPERADMIN
  ADMIN
  CAISSIER
  EMPLOYEE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationStatus {
  READ
  UNREAD
}

enum ContractType {
  FIXE
  HONORAIRE
}

enum PayrunStatus {
  DRAFT
  CALCULATED
  VALIDATED
  PAID
  CLOSED
}

model Loan {
  id            Int           @id @default(autoincrement())
  employeeId    Int
  amount        Float
  interestRate  Float         @default(0)
  termMonths    Int
  monthlyPayment Float
  remainingAmount Float
  status        LoanStatus    @default(ACTIVE)
  purpose       String?
  grantedBy     Int           // User ID du caissier qui a accordé le prêt
  approvedBy    Int?          // User ID de l'admin qui a approuvé (optionnel)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  employee      Employee      @relation(fields: [employeeId], references: [id])
  grantedByUser User          @relation("LoanGrantedBy", fields: [grantedBy], references: [id])
  approvedByUser User?        @relation("LoanApprovedBy", fields: [approvedBy], references: [id])
  payments      LoanPayment[]

  @@index([employeeId], map: "loans_employeeId_fkey")
  @@index([grantedBy], map: "loans_grantedBy_fkey")
  @@index([approvedBy], map: "loans_approvedBy_fkey")
  @@map("loans")
}

model LoanPayment {
  id        Int           @id @default(autoincrement())
  loanId    Int
  amount    Float
  paidAt    DateTime      @default(now())
  loan      Loan          @relation(fields: [loanId], references: [id])

  @@index([loanId], map: "loan_payments_loanId_fkey")
  @@map("loan_payments")
}

enum LoanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}
